{
	"name": "draw-tikz",
	"displayName": "draw.tikz",
	"description": "Visual editor for CircuiTikZ/TikZ drawings: edit *.drawtikz.json files and export them to TikZ or SVG",
	"version": "0.1.0",
	"publisher": "willem-v",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/Willem-V/draw.tikz.git"
	},
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "drawtikz.editor",
				"displayName": "draw.tikz",
				"selector": [
					{
						"filenamePattern": "*.drawtikz.json"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "drawtikz.newDrawing",
				"title": "New drawing",
				"category": "draw.tikz"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "drawtikz.newDrawing",
					"group": "navigation@9"
				}
			]
		},
		"configuration": {
			"title": "draw.tikz",
			"properties": {
				"drawtikz.defaultExportFolder": {
					"type": "string",
					"default": "fig",
					"description": "Folder (relative to the workspace folder) suggested when a drawing is exported for the first time"
				}
			}
		}
	},
	"scripts": {
		"build:app": "cd .. && npx parcel build --public-url ./ --dist-dir vscode/media/app --cache-dir vscode/.parcel-cache --no-source-maps",
		"build:icon": "node -e \"require('fs').mkdirSync('media',{recursive:true});require('fs').copyFileSync('../src/icons/android-icon-192x192.png','media/icon.png')\"",
		"build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
		"build": "npm run build:app && npm run build:icon && npm run build:extension",
		"package": "npm run build && vsce package",
		"check": "tsc --noEmit -p ."
	},
	"devDependencies": {
		"@types/node": "^20.19.0",
		"@types/vscode": "~1.90.0",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.25.0",
		"typescript": "^5.9.2"
	}
}
